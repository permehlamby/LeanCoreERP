{
  "source": { "title": "Guidance for the Standard Audit File - Tax, Version 2.0, Appendix B: Schema", "authority": "OECD", "schema": "SAF-T_Schema_v_2.00.xsd", "namespace": "urn:OECD:StandardAuditFile-Taxation/2.00", "url": "https://web-archive-storage.oecd.org/aemint-web-archive-prod/web-archive/cc/ccd3b76ffdaf3c1f3e185a390dba41be2876b0e826925278bbb3e62ad37442bf.pdf", "pdf_sha256": "e292e7b54a9d816e9e38587ec107980d6cd813831bc20038890dc66f07146ad7", "extraction": "Text extracted mechanically from the PDF (133 pages). Occurrence and type per element as printed in the appendix. The archived copy is to be compared with the current OECD download" },
  "standard": "OECD SAF-T 2.00",
  "scope": "Header, MasterFiles (GeneralLedgerAccounts, Customers, Suppliers, TaxTable, UOMTable, Products), GeneralLedgerEntries, SourceDocuments (SalesInvoices, PurchaseInvoices, Payments). Not covered: Taxonomies, AnalysisTypeTable, MovementTypeTable, PhysicalStock, Owners, Assets, MovementOfGoods, AssetTransactions",
  "statuses": "MAPPED: a core column. DERIVED: computed from core data or a core read. CONSTANT: a fixed value. JOB: from the export job. GAP: mandatory in the schema and not held by the core. OMITTED: optional parent, not produced",
  "note": "App content (assembly specification, 12, 8). The core produces the data set, an app writes the XML. Core names are those of specs 02, 07, 10 and 11. Column names marked in the source column that read 'sales_invoice_line or purchase_invoice_line' are alternatives by context. A context of * applies to every use. Every mandatory element of the covered scope has an entry or lies below an entry.",
  "entries": [
