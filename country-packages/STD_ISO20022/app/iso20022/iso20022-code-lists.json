    "rules":  {
                  "character_set":  {
                                        "basis":  "EPC",
                                        "source":  "EPC132-08 2025 V1.0, 1.4",
                                        "text":  "Latin set: a-z A-Z 0-9 / - ? : ( ) . , apostrophe plus and space. References, identifications and identifiers use only this set, must not start or end with a slash and must not contain two slashes. Other characters only by bilateral agreement. XML itself is UTF-8"
                                    },
                  "address":  {
                                  "basis":  "EPC",
                                  "source":  "EPC132-08 2025 V1.0, 1.7 and the usage rule of PstlAdr",
                                  "text":  "From 22 November 2026 only structured and hybrid addresses are allowed, unstructured are not. Structured: Town Name and Country mandatory, no Address Line. Hybrid: Town Name, Country and at least one Address Line. A search result (secondary, not verified) says an EPC update moves the date to 15 November 2026"
                              },
                  "field_lengths":  {
                                        "basis":  "EPC",
                                        "text":  "MsgId, PmtInfId, EndToEndId, InstrId: 35. Names: 70. Remittance unstructured: 140. Creditor reference: 35. Address line: 70 (two lines). BIC: 8 or 11"
                                    },
                  "iban_check":  {
                                     "basis":  "KNOWLEDGE",
                                     "algorithm":  "Move the first four characters to the end, replace letters by numbers (A=10 to Z=35), the number modulo 97 must be 1",
